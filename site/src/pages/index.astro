---
// The landing page sits outside the Starlight layout on purpose: the diagram is
// the first thing, full viewport, with no chrome in front of it.
import registry from '../data/registry.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const surface = `${registry.commands} commands · ${registry.groups} groups`;
const bin = registry.binary;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>aos — the machine, as one command surface</title>
		<meta
			name="description"
			content={`One CLI over the machine that agents drive the same way you do \u2014 as an installed agent skill, or over MCP. ${registry.commands} commands across ${registry.groups} groups, on macOS, Windows and Linux.`}
		/>
		<link rel="icon" href={`${base}/favicon.svg`} />
	</head>
	<body>
		<canvas id="c"></canvas>
		<div id="fps"></div>
		<a id="scroll" href="#start">↓</a>

		<section id="start">
			<h1>aos</h1>
			<p class="lede">
				One CLI over the machine &mdash; windows, input, screenshots, files, shell commands, packages
				&mdash; that an agent drives the same way you do. Install the skill and your agent just
				uses it; serve it over MCP when you want typed tools instead. Same commands, one code
				path, three platforms.
			</p>

			<pre><code>{`go install github.com/muthuishere/aos/cmd/${bin}@latest
${bin} install --skills
${bin} doctor`}</code></pre>

			<p class="links">
				<a class="primary" href={`${base}/what-it-is/`}>Read the docs</a>
				<a href={`${base}/what-it-is-not/`}>What it&rsquo;s not</a>
				<a href={`${base}/reference/commands/`}>Every command</a>
				<a href="https://github.com/muthuishere/aos">GitHub</a>
			</p>

			<p class="foot">
				{surface} · macOS, Windows and Linux, including a headless Linux server.
			</p>
		</section>

		<style is:global>
			html,
			body {
				margin: 0;
				background: #f4f3ef;
				color: #1c1b19;
				font: 16px/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Helvetica, Arial,
					sans-serif;
			}
			canvas#c {
				display: block;
				width: 100vw;
				height: 100vh;
			}
			#fps {
				position: fixed;
				right: 10px;
				bottom: 8px;
				font: 11px ui-monospace, SFMono-Regular, Menlo, monospace;
				color: #b9b5ab;
				letter-spacing: 0.04em;
				user-select: none;
			}
			#scroll {
				position: absolute;
				top: calc(100vh - 46px);
				left: 50%;
				transform: translateX(-50%);
				width: 30px;
				height: 30px;
				line-height: 30px;
				text-align: center;
				color: #8a857c;
				text-decoration: none;
				border: 1px solid #d6d2c8;
				border-radius: 50%;
				background: #fff;
			}
			#start {
				max-width: 720px;
				margin: 0 auto;
				padding: 88px 24px 120px;
				border-top: 1px solid #d6d2c8;
			}
			#start h1 {
				font-size: 46px;
				margin: 0;
				letter-spacing: -0.02em;
			}
			.formal {
				margin: 2px 0 14px;
				font: 600 12px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				letter-spacing: 0.18em;
				color: #8a857c;
				text-transform: lowercase;
			}
			.lede {
				color: #57534b;
				font-size: 18px;
				margin: 0 0 28px;
			}
			#start pre {
				background: #151412;
				color: #e6e2d9;
				padding: 18px 20px;
				border-radius: 10px;
				overflow-x: auto;
				font: 13.5px/1.7 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				margin: 28px 0 0;
			}
			.links a {
				border: 1px solid #d6d2c8;
				background: #fff;
				color: #1c1b19;
				border-radius: 8px;
				padding: 9px 16px;
				text-decoration: none;
				font-size: 14.5px;
			}
			.links a.primary {
				background: #e08a1e;
				border-color: #e08a1e;
				color: #fff;
			}
			.foot {
				margin-top: 34px;
				color: #8a857c;
				font-size: 13.5px;
			}
			@media (prefers-reduced-motion: reduce) {
				#fps {
					display: none;
				}
			}
		</style>

		<script is:inline set:html={`window.AOS_STATS=${JSON.stringify(registry)}`} />
		<script is:inline src={`${base}/canvas.js`}></script>
	</body>
</html>
