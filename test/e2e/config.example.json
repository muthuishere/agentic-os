{
  "_comment": "Copy to config.json (gitignored) and edit. Every field but name/kind/binary is optional.",
  "targets": [
    {
      "name": "local",
      "kind": "local",
      "binary": "../../dist/aos",
      "hasDisplay": true,
      "timeoutSeconds": 60
    },
    {
      "name": "windows-vm",
      "kind": "agentbus",
      "node": "REPLACE-WITH-agentbus-node-name",
      "binary": "../../dist/aos-windows-arm64.exe",
      "shell": "cmd",
      "hasDisplay": true,
      "timeoutSeconds": 90
    },
    {
      "name": "linux-server",
      "kind": "ssh",
      "host": "REPLACE-WITH-ssh-host",
      "binary": "../../dist/aos-linux-amd64",
      "remotePath": "/tmp/aos-e2e",
      "hasDisplay": false,
      "timeoutSeconds": 60
    }
  ]
}
